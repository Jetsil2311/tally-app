# Copy to .env.local and fill in.

# The finance-tracker API (it runs on :3000, so this app runs on :3001)
API_URL="http://localhost:3000"

# Where this dashboard is served. The Google OAuth redirect URI is
# ${APP_URL}/auth/callback and must be listed in Google Cloud Console under
# the web client's "Authorized redirect URIs".
APP_URL="http://localhost:3001"

# The same Google web client the API accepts (in its GOOGLE_CLIENT_ID list)
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""
